# ssh-vpn deployment example
# This service reads environment variables instead of config.ini.
#
# Local lab:
#   REMOTE_LOG_URL -> systemwire2 account alert receiver
#   SSHD_BIND / VPN_PORT -> ports exposed by the fake SSH / VPN honeypots
#
# Internet deployment:
#   REMOTE_LOG_URL -> https://<systemwire2-host>/account/alert
#   SSHD_BIND      -> :22 to listen on all interfaces, or 0.0.0.0:22 / <public-ip>:22 for an explicit bind
#   VPN_PORT       -> :1194 to listen on all interfaces, or 0.0.0.0:1194 / <public-ip>:1194 for an explicit bind
#   SSHD_KEY_KEY   -> stable secret used to derive deterministic fake SSH host keys

REMOTE_LOG_URL=http://127.0.0.1:5001/account/alert
SSHD_BIND=:22
VPN_PORT=:1194
SSHD_KEY_KEY=change-me