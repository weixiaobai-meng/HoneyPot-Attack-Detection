[agent]
id = agent-001
name = 触发端探针

[server]
# 中心服务端地址（需要修改为实际IP）
address = 47.239.238.27:50051
use_tls = false
timeout = 30

[auth]
# Token需要与中心服务端配置保持一致
token = your-secret-token-here

[monitor]
# 监控的路径，逗号分隔
watch_paths = /tmp,/home,/var/www
# 监控的文件扩展名
watch_extensions = .txt,.log,.conf,.key,.pem,.db

[alert]
# 告警发送地址
alert_server = http://47.239.238.27:9090
retry_times = 3
retry_interval = 5

[log]
level = info
file = ./agent.log
max_size = 100
max_backups = 3
