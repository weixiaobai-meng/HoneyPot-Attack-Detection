# agent-go local example
# Change ServerAddress and Token when you register a new local probe in systemwire2.
[AGENT]
AgentMode = online
ServerAddress = 127.0.0.1:50051
Token = REPLACE_WITH_AGENT_TOKEN
ReportInterval = 5
RealTimeUpdate = true
MonitorType = audit
MonitorListConfigPath = config/paths.list
LogPath = log/agent.log

[TLS]
Enable = true
AuthType = 2
ServerCertPath = ssl/server.crt
ClientCertPath = ssl/client.crt
ClientKeyPath = ssl/client.key
CACertPath = ssl/ca.crt
ServerName = *.cfly.top
